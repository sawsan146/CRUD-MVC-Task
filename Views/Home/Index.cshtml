@{
    ViewData["Title"] = "Home Page";
}
@model List<ProductViewModel>
<h1>Our Products</h1>
<a class="btn btn-danger" asp-controller="Home" asp-action="AddProduct">AddProduct</a>
<table class="table table-bordered">

    <tr>
        <th>Product Name</th>
        <th>Price</th>
        <th>Qty</th>
    </tr>
@foreach (var product in Model)
{
    <tr>
        <td>@product.Name</td>
        <td>@product.Price</td>
        <td>@product.Qty</td>
         <td><a class="btn btn-success" asp-controller="Home" asp-action="UpdateProduct" asp-route-id="@product.Id">Edit Product</a></td>
          <td> 
              <form asp-controller="Home" asp-action="DeleteProduct" asp-route-id="@product.Id" method="post" onsubmit="return confirm('Are you sure you want to delete this product?');">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-danger">Delete Product</button>
            </form>
            </td>

    </tr>
}
</table>